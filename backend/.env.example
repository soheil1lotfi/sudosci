# ---------------------------------------------------------------------------
# Model serving (vLLM, OpenAI-compatible endpoint)
# ---------------------------------------------------------------------------
# Inside docker-compose the API talks to the vllm service by name.
LLM_BASE_URL=http://vllm:8000/v1
LLM_API_KEY=local-dev-key
LLM_MODEL=google/gemma-4-12B-it

# ---------------------------------------------------------------------------
# Research MCP (alien.club)
# ---------------------------------------------------------------------------
# The ?config=... segment selects which toolset the server exposes; it is not a
# credential. Auth is the bearer token below.
MCP_URL=https://mcp.alien.club/mcp?config=cfg_UtzjgjDLGNrW

# Preferred: a long-lived API key from alien.club (starts with `oat_`).
MCP_API_KEY=

# Fallback, only if no static key is available. Produced by a one-time browser
# login: `python scripts/mcp_login.py`.
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=
MCP_REFRESH_TOKEN=

# Offer the model BnF/Gallica archive search as well. Off by default - it only
# helps historical claims, and each extra tool costs tool-choice accuracy.
MCP_ENABLE_ARCHIVE=false

# ---------------------------------------------------------------------------
# Pipeline tuning
# ---------------------------------------------------------------------------
# Max search calls per individual claim (FIRE-style budget).
MAX_SEARCHES_PER_CLAIM=3
# Max search calls for one whole request, across all claims.
MAX_SEARCHES_PER_REQUEST=24
# How many claims to verify concurrently.
CLAIM_CONCURRENCY=4
# Claims extracted from one transcript, hard cap.
MAX_CLAIMS=12

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Optional bearer token clients must present. Blank = no auth (dev only).
API_KEY=
LOG_LEVEL=INFO
